{
  "manifest_version": 3,
  "name": "Tallgrass — by MacRandle Acres",
  "version": "31.0",
  "description": "Ranks every Facebook post against the median of its own group, so a quiet group's runaway hit stops hiding behind a big one.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "activeTab",
    "alarms"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://tallgrassapp.com/*",
    "https://*.tallgrassapp.com/*",
    "https://outlier-q7ie.onrender.com/*",
    "https://*.facebook.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/*",
        "https://web.facebook.com/*"
      ],
      "exclude_matches": [
        "https://www.facebook.com/messages/*",
        "https://web.facebook.com/messages/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://tallgrassapp.com/*",
        "https://*.tallgrassapp.com/*",
        "https://outlier-q7ie.onrender.com/*"
      ],
      "js": [
        "connect.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Tallgrass",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
